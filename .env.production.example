# =============================================================================
# Lunara E-Commerce - Production Environment Configuration
# =============================================================================
# INSTRUKSI: Copy file ini ke .env di server production, lalu isi semua value
# yang ditandai dengan [GANTI_DENGAN_...] sesuai environment Anda.
# =============================================================================

APP_NAME=Lunara
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# =============================================================================
# Logging
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =============================================================================
# Database (MySQL)
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lunara_production
DB_USERNAME=[GANTI_DENGAN_DB_USERNAME]
DB_PASSWORD=[GANTI_DENGAN_DB_PASSWORD]

# =============================================================================
# Session, Queue, Cache
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# =============================================================================
# Redis (optional, uncomment jika pakai Redis)
# =============================================================================
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# =============================================================================
# Mail (sesuaikan dengan SMTP provider Anda)
# =============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=[GANTI_DENGAN_EMAIL]
MAIL_PASSWORD=[GANTI_DENGAN_APP_PASSWORD]
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

# =============================================================================
# AWS (optional)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# Vite
# =============================================================================
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Google OAuth
# =============================================================================
GOOGLE_CLIENT_ID=[GANTI_DENGAN_GOOGLE_CLIENT_ID]
GOOGLE_CLIENT_SECRET=[GANTI_DENGAN_GOOGLE_CLIENT_SECRET]
GOOGLE_REDIRECT_URL=https://your-domain.com/auth/google/callback

# =============================================================================
# Midtrans Payment Gateway
# =============================================================================
MIDTRANS_SERVER_KEY=[GANTI_DENGAN_MIDTRANS_SERVER_KEY]
MIDTRANS_CLIENT_KEY=[GANTI_DENGAN_MIDTRANS_CLIENT_KEY]
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true
